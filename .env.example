# Copy the values you need into .env — never commit real secrets.

# --- Reader (public) -------------------------------------------------------
# Supabase connection. The publishable key is safe in the browser; row-level
# security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Generation (server only) ---------------------------------------------
LOVABLE_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=

# --- Authoring -------------------------------------------------------------
# Shared secret guarding every server function that writes a book, spends AI
# credits or deletes artwork. Leave it UNSET in the reader deployment: with no
# token configured those functions refuse every call, which is the safe state.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Set to 1 only in a local or staging build to show the operator tools:
# the create page, the delete/repaint controls and the ?unlockAll=1 switch.
# Must stay unset in the build children install.
VITE_ENABLE_AUTHORING=
