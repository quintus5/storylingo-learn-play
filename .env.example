# Copy the values you need into .env — never commit real secrets.

# --- Reader (public) -------------------------------------------------------
# Supabase connection. The publishable key is safe in the browser; row-level
# security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Generation (server only) ---------------------------------------------
# LOVABLE_API_KEY still serves text generation (chatJson in ai.server.ts) —
# only illustrations have moved off it so far.
LOVABLE_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=

# Illustrations: BytePlus ModelArk, calling ByteDance's Seedream model
# directly instead of through the Lovable gateway, at roughly half Gemini's
# per-image cost. Create a key in the BytePlus console (console.byteplus.com
# > ModelArk > API Keys) and confirm the Seedream model is enabled for the
# account before the first real generation.
SEEDREAM_API_KEY=
# The exact model id from the console's model list — these are dated
# (e.g. seedream-5-0-lite-<date>) and do change, so there is no safe default.
SEEDREAM_MODEL=
# Optional overrides. The default endpoint is the ap-southeast region, the
# nearest to Thailand; a China-region account needs a different host, e.g.
# https://ark.cn-beijing.volces.com/api/v3/images/generations.
SEEDREAM_ENDPOINT=
# "1K" is the cheapest tier and enough for this pipeline, which never stores
# more than 1280px — confirm "1K" is a valid size string for the exact model
# above before relying on the default.
SEEDREAM_SIZE=

# --- Accounts --------------------------------------------------------------
# Sign-in is Google only, configured in the Supabase dashboard rather than
# here: Authentication > Providers > Google, with a client ID and secret from
# the Google Cloud console. Add every origin the app runs on to the redirect
# allow list, including http://localhost:8080 for local work.
# Making a book requires an account; reading the shelf never does.

# --- Operator --------------------------------------------------------------
# Shared secret guarding the catalogue-wide actions: deleting a book,
# repainting one, publishing to the shared shelf and listing books for review.
# With no token configured those refuse every call, which is the safe state.
# Ordinary book creation does NOT use this — it uses the signed-in account.
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=

# Set to 1 only in a local or staging build to show the operator controls:
# the delete/repaint buttons, the hidden dev menu and the ?unlockAll=1 switch.
# Must stay unset in the build children install.
VITE_ENABLE_AUTHORING=
